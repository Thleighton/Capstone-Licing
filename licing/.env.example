# Supabase Usuarios/Licitaciones: Auth y tabla public.usuario existentes.
# Para usar también su PostgreSQL, consulta .env.supabase.example.
USUARIOS_URL=
USUARIOS_ANON_KEY=

# Core: puedes conservar estos valores en backend/licing-core/.env.
# Los valores del .env de Core tienen prioridad sobre este archivo.
MP_TICKET=
MP_BASE_URL=https://api.mercadopublico.cl/servicios/v1/publico
DATABASE_URL=postgresql+psycopg://licing:licing@localhost:5432/licing
MAX_RAW_ITEMS=20
MP_PAUSA_DETALLES_SEGUNDOS=5
