# Copia este archivo como .env (en la raíz del repo) y completa los valores.
# En Vercel se cargan en Settings > Environment Variables. NUNCA subir .env al repo.

# Ticket de la API de Mercado Publico (https://www.chilecompra.cl/api/)
MP_TICKET=

# Proyecto Supabase Licing/Datos (Project Settings > API)
SUPABASE_URL=
# service_role: solo servidor. Nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto para llamar /api/sync. Vercel lo envía solo en el cron si está definida.
CRON_SECRET=

# Opcional: máximo de fichas de detalle por fuente y ejecución (default 30)
# MAX_DETALLES=30

# Proyecto Supabase Licing/Usuarios (login). La anon key es pública.
USUARIOS_URL=
USUARIOS_ANON_KEY=
