# Copiar como .env.supabase dentro de licing/. No subir ese archivo a Git.
# Un solo proyecto Supabase: Usuarios/Licitaciones.
# Copiar HOST y REF desde Connect > Session pooler (puerto 5432).
# Reemplazar CLAVE_CODIFICADA por la contraseña de PostgreSQL codificada para URL.
DATABASE_URL=postgresql+psycopg://postgres.REF:CLAVE_CODIFICADA@HOST:5432/postgres?sslmode=require

# Login: URL y clave pública del MISMO proyecto (usar el mismo REF).
# La variable conserva su nombre histórico y también admite una publishable key.
USUARIOS_URL=https://REF.supabase.co
USUARIOS_ANON_KEY=sb_publishable_REEMPLAZAR

MP_TICKET=REEMPLAZAR
MP_BASE_URL=https://api.mercadopublico.cl/servicios/v1/publico
MP_PAUSA_DETALLES_SEGUNDOS=5
MAX_RAW_ITEMS=20
