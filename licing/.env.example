# Variables para api/sync.js. En Vercel se cargan en Settings > Environment Variables.
# NUNCA subir el archivo .env real al repositorio.

# Ticket de la API de Mercado Publico (https://www.chilecompra.cl/api/)
MP_TICKET=

# Proyecto Supabase de Licing (Project Settings > API)
SUPABASE_URL=
# anon/publishable: la usa index.html (via /api/config). Es publica; la protege RLS.
SUPABASE_ANON_KEY=
# service_role: solo servidor. Nunca en index.html.
SUPABASE_SERVICE_ROLE_KEY=
# Secreto para llamar /api/sync. Vercel lo envia solo en el cron si esta definida.
# Generar uno largo y aleatorio.
CRON_SECRET=

# Opcional: maximo de fichas de detalle a descargar por fuente y por ejecucion (default 30)
# MAX_DETALLES=30
